# The five visual scenarios of spec 5 §14, as theme files generated by
# the real module. `nix build ./nix/tests#stylix-themes` links them into
# one folder for scripts/ui/stylix-themes.sh, which takes the screenshots.
args@{ stylix, ... }:
let
  t = import ./lib.nix args;
  inherit (t) pkgs homeConfig;

  scheme = name: "${pkgs.base16-schemes}/share/themes/${name}.yaml";

  themeFile =
    stylixSettings: modules:
    (homeConfig (
      [
        stylix.homeModules.stylix
        {
          stylix = {
            enable = true;
          }
          // stylixSettings;
          programs.seshat.enable = true;
        }
      ]
      ++ modules
    )).programs.seshat.themeFile;

  scenarios = {
    dark = themeFile {
      base16Scheme = scheme "gruvbox-dark-hard";
      polarity = "dark";
    } [ ];
    light = themeFile {
      base16Scheme = scheme "gruvbox-light-hard";
      polarity = "light";
    } [ ];
    # A strongly contrasting accent.
    accent = themeFile { base16Scheme = scheme "outrun-dark"; } [ ];
    # Fonts the headless test session has, so the change is visible.
    fonts = themeFile {
      base16Scheme = scheme "gruvbox-dark-hard";
      polarity = "dark";
      fonts.sansSerif = {
        name = "DejaVu Serif";
        package = pkgs.dejavu_fonts;
      };
      fonts.sizes.applications = 14;
    } [ ];
    overrides = themeFile {
      base16Scheme = scheme "gruvbox-dark-hard";
      polarity = "dark";
    } [
      {
        programs.seshat.theme = {
          name = "Stylix with overrides";
          colors.accent = "#ff5555";
          colors.focus = "#ff5555";
          colors.navigation_selected = "#3c3836";
        };
      }
    ];
  };
in
pkgs.linkFarm "seshat-stylix-themes" (
  pkgs.lib.mapAttrsToList (name: path: {
    name = "${name}.toml";
    inherit path;
  }) scenarios
)
